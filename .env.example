# Source data package mounted on the deployment host.
PACKAGE_ROOT=../PHRC_BGCStructDB_v1

# Optional runtime override. Relative values resolve inside the app package.
# Leave unset for the bundled read-only database at app/data/phrc_bgcstructdb.sqlite.
# DATABASE_PATH=data/phrc_bgcstructdb.sqlite

PUBLIC_BASE_URL=http://127.0.0.1:8000
ENVIRONMENT=development
LOG_LEVEL=info

# Optional; reserved for future signed URLs/admin utilities. The public v1 app is read-only.
SECRET_KEY=change-me-only-if-needed

PHRC_VERSION=PHRC_BGCStructDB_v1
PHRC_CONTACT_EMAIL=contact@example.edu
